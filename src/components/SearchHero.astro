---
import Search from "./Search.astro";

interface Props {
    articleCount?: number;
    categoryCount?: number;
    lastUpdatedLabel?: string;
}

const {
    articleCount = 0,
    categoryCount = 0,
    lastUpdatedLabel = "recently",
} = Astro.props;
---

<section class="relative overflow-hidden bg-gradient-to-b from-[#090d16] via-slate-950 to-[#090d16] border-y border-slate-800/80 text-white py-14 sm:py-20">
    <!-- Subtle Ambient Glow -->
    <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-sky-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="container-wide text-center relative z-10 px-4 sm:px-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-500/10 border border-sky-500/20 text-sky-400 text-xs font-semibold mb-5">
            <span class="w-2 h-2 rounded-full bg-sky-400"></span>
            <span>Documentation &amp; Developer Guides</span>
        </div>

        <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-4 leading-tight">
            Knowledge Base &amp; <span class="bg-gradient-to-r from-sky-400 to-indigo-400 bg-clip-text text-transparent">API Guides</span>
        </h2>
        <p class="text-slate-400 text-sm sm:text-base leading-relaxed max-w-2xl mx-auto mb-8">
            Explore deep technical guides on smart device routing, country geo-targeting, webhook payload delivery, Prometheus telemetry, and REST endpoints.
        </p>

        <div class="max-w-2xl mx-auto mb-8">
            <Search />
        </div>

        <div class="flex justify-center flex-wrap gap-4 pt-6 border-t border-slate-800/80 max-w-3xl mx-auto">
            <div class="min-w-[120px] px-5 py-3 rounded-xl bg-slate-900/80 border border-slate-800 backdrop-blur-md shadow-lg">
                <div class="text-2xl font-extrabold text-white">
                    {articleCount}
                </div>
                <div class="text-[11px] uppercase tracking-wider font-semibold text-slate-400 mt-1">
                    Technical Docs
                </div>
            </div>
            <div class="min-w-[120px] px-5 py-3 rounded-xl bg-slate-900/80 border border-slate-800 backdrop-blur-md shadow-lg">
                <div class="text-2xl font-extrabold text-white">
                    {categoryCount}
                </div>
                <div class="text-[11px] uppercase tracking-wider font-semibold text-slate-400 mt-1">
                    Categories
                </div>
            </div>
            <div class="min-w-[150px] px-5 py-3 rounded-xl bg-slate-900/80 border border-slate-800 backdrop-blur-md shadow-lg">
                <div class="text-2xl font-extrabold text-white">
                    {lastUpdatedLabel}
                </div>
                <div class="text-[11px] uppercase tracking-wider font-semibold text-slate-400 mt-1">
                    Last Updated
                </div>
            </div>
        </div>
    </div>
</section>
