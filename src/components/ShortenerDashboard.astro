<script is:inline>
  function docTabs() {
    return {
      activeDocTab: 'architecture',
      activeSnippetTab: 'curl'
    };
  }

  const shortenerEl = document.getElementById('shortener');
  const configuredApi = shortenerEl ? shortenerEl.getAttribute('data-api-base') : '';
  const API_BASE = (configuredApi || (window.location.port === '4321' ? 'http://localhost:8080' : '')).replace(/\/+$/, '');
  let feLatestCode = '';

  function feToggleSection(secId, iconId) {
    const el = document.getElementById(secId);
    const icon = document.getElementById(iconId);
    if (el.classList.contains('hidden')) {
      el.classList.remove('hidden');
      icon.classList.add('rotate-180');
    } else {
      el.classList.add('hidden');
      icon.classList.remove('rotate-180');
    }
  }

  async function fePasteUrl() {
    try {
      const text = await navigator.clipboard.readText();
      if (text) document.getElementById('feOriginalUrl').value = text;
    } catch (e) {}
  }

  async function handleFeCreateLink(event) {
    event.preventDefault();
    const btn = document.getElementById('feSubmitBtn');
    btn.disabled = true;
    btn.innerText = 'Creating Shortlink...';

    const payload = {
      original_url: document.getElementById('feOriginalUrl').value.trim(),
      custom_code: document.getElementById('feCustomCode').value.trim() || undefined,
      title: document.getElementById('feLinkTitle').value.trim() || undefined,
      ios_url: document.getElementById('feIosUrl').value.trim() || undefined,
      android_url: document.getElementById('feAndroidUrl').value.trim() || undefined,
      country_code: document.getElementById('feCountryCode').value.trim() || undefined,
      country_url: document.getElementById('feCountryUrl').value.trim() || undefined,
      password: document.getElementById('fePassword').value || undefined,
      fallback_url: document.getElementById('feFallbackUrl').value.trim() || undefined,
      webhook_url: document.getElementById('feWebhookUrl').value.trim() || undefined,
    };

    const maxClicks = document.getElementById('feMaxClicks').value;
    if (maxClicks) payload.max_clicks = parseInt(maxClicks, 10);

    const expiresAt = document.getElementById('feExpiresAt').value;
    if (expiresAt) payload.expires_at = new Date(expiresAt).toISOString();

    try {
      const res = await fetch(API_BASE + '/api/v1/links/public', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const data = await res.json();
      if (!res.ok) {
        alert('Error: ' + (data.message || 'Failed to create shortlink'));
        return;
      }

      const link = data.data;
      feLatestCode = link.short_code;

      document.getElementById('feCreatedCodeBadge').innerText = '/' + link.short_code;
      document.getElementById('feShortUrlDisplay').value = link.short_url;
      document.getElementById('feTestLinkBtn').href = link.short_url;
      document.getElementById('feQrCodeImg').src = API_BASE + '/qr/' + link.short_code;
      document.getElementById('feResultBox').classList.remove('hidden');

      document.getElementById('feInspectCode').value = link.short_code;
    } catch (err) {
      alert('Network error connecting to Backend: ' + err.message);
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<svg class="w-5 h-5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>Shorten URL Now';
    }
  }

  function feCopyToClipboard() {
    const input = document.getElementById('feShortUrlDisplay');
    input.select();
    navigator.clipboard.writeText(input.value);
    const txt = document.getElementById('feCopyBtnText');
    txt.innerText = 'Copied!';
    setTimeout(() => txt.innerText = 'Copy Link', 2000);
  }

  function feInspectCreated() {
    if (feLatestCode) {
      document.getElementById('feInspectCode').value = feLatestCode;
      feInspectAnalytics();
    }
  }

  async function feInspectAnalytics() {
    const code = document.getElementById('feInspectCode').value.trim();
    if (!code) {
      alert('Please enter a short code');
      return;
    }

    try {
      const res = await fetch(API_BASE + '/api/v1/analytics/public/' + encodeURIComponent(code));
      const data = await res.json();
      if (!res.ok) {
        alert('Analytics error: ' + (data.message || 'Not found'));
        return;
      }

      const summary = data.data;
      document.getElementById('feAnalyticsEmpty').classList.add('hidden');
      document.getElementById('feAnalyticsContent').classList.remove('hidden');

      document.getElementById('feStatTotalClicks').innerText = (summary.total_clicks || 0).toLocaleString();
      document.getElementById('feStatUniqueVisitors').innerText = (summary.unique_clicks || 0).toLocaleString();

      const devList = document.getElementById('feDeviceList');
      devList.innerHTML = '';
      if (summary.device_breakdown && summary.device_breakdown.length > 0) {
        summary.device_breakdown.forEach(item => {
          devList.innerHTML += '<div class="flex justify-between items-center py-1 border-b border-slate-800/40"><span class="text-slate-400 capitalize">' + (item.device_type || 'Unknown') + '</span><span class="font-mono font-bold text-slate-200">' + item.count + '</span></div>';
        });
      } else {
        devList.innerHTML = '<span class="text-slate-500 text-xs">No click logs recorded yet</span>';
      }

      const countryList = document.getElementById('feCountryList');
      countryList.innerHTML = '';
      if (summary.country_breakdown && summary.country_breakdown.length > 0) {
        summary.country_breakdown.forEach(item => {
          countryList.innerHTML += '<div class="flex justify-between items-center py-1 border-b border-slate-800/40"><span class="text-slate-400">' + (item.country || 'Unknown') + '</span><span class="font-mono font-bold text-slate-200">' + item.count + '</span></div>';
        });
      } else {
        countryList.innerHTML = '<span class="text-slate-500 text-xs">No geographical data yet</span>';
      }

      document.getElementById('feExportCsvBtn').href = API_BASE + '/api/v1/analytics/' + encodeURIComponent(code) + '/export.csv';
    } catch (err) {
      alert('Failed to connect to Analytics: ' + err.message);
    }
  }
</script>
