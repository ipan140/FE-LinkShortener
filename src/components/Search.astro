---
---

<div
    x-data="{
        open: false,
        focused: false,
        query: '',
        loading: false,
        results: [],
        popular: [],
        fallbackIndex: [],
        fallbackLoadState: 'idle',
        fallbackPromise: null,
        pagefindStatus: 'unknown',
        searchRequestId: 0,
        fallbackReported: false,
        init() {
            this.ensureFallbackData();
        },
        async ensureFallbackData() {
            if (this.fallbackLoadState === 'ready') return true;
            if (this.fallbackLoadState === 'loading' && this.fallbackPromise) {
                await this.fallbackPromise;
                return this.fallbackLoadState === 'ready';
            }

            this.fallbackLoadState = 'loading';
            this.fallbackPromise = fetch('/search-index.json')
                .then((res) => {
                    if (!res.ok) {
                        throw new Error(`Fallback index request failed (${res.status})`);
                    }
                    return res.json();
                })
                .then((payload) => {
                    this.fallbackIndex = Array.isArray(payload?.docs) ? payload.docs : [];
                    this.popular = Array.isArray(payload?.popular) ? payload.popular : [];
                    this.fallbackLoadState = 'ready';
                })
                .catch((error) => {
                    console.error('Fallback search index failed to load:', error);
                    this.fallbackLoadState = 'error';
                    this.fallbackIndex = [];
                    this.popular = [];
                });

            await this.fallbackPromise;
            return this.fallbackLoadState === 'ready';
        },
        scoreFallbackItem(item, q, tokens) {
            const title = (item.title || '').toLowerCase();
            const excerpt = (item.excerpt || '').toLowerCase();
            const category = (item.category || '').toLowerCase();

            let score = 0;
            if (title === q) score += 300;
            if (title.startsWith(q)) score += 180;
            if (title.includes(q)) score += 120;
            if (category.includes(q)) score += 50;
            if (excerpt.includes(q)) score += 35;

            for (const token of tokens) {
                if (title.startsWith(token)) score += 50;
                else if (title.includes(token)) score += 30;
                if (category.includes(token)) score += 10;
                if (excerpt.includes(token)) score += 8;
            }

            return score;
        },
        fallbackSearch(term) {
            const q = term.trim().toLowerCase();
            if (!q) return [];
            const tokens = q.split(/\s+/).filter(Boolean);

            return this.fallbackIndex
                .map((item) => ({
                    item,
                    score: this.scoreFallbackItem(item, q, tokens),
                }))
                .filter((entry) => entry.score > 0)
                .sort((a, b) => {
                    if (b.score !== a.score) return b.score - a.score;
                    return a.item.title.localeCompare(b.item.title);
                })
                .slice(0, 8)
                .map(({ item }) => ({
                    url: item.url,
                    title: item.title,
                    excerptText: item.excerpt,
                }));
        },
        reportFallback(reason) {
            if (this.fallbackReported) return;
            this.fallbackReported = true;
            window.dispatchEvent(
                new CustomEvent('sgkb:search:fallback', {
                    detail: { reason },
                }),
            );
        },
        async search() {
            const currentRequestId = ++this.searchRequestId;
            const term = this.query.trim();

            if (!term) {
                this.results = [];
                this.loading = false;
                return;
            }

            this.loading = true;

            const useFallback = async (reason) => {
                this.reportFallback(reason);
                await this.ensureFallbackData();
                if (currentRequestId !== this.searchRequestId) return;
                this.results = this.fallbackSearch(term);
                this.loading = false;
            };

            const pagefindAvailable =
                typeof window !== 'undefined' &&
                (typeof (window as any).pagefind !== 'undefined' ||
                    this.pagefindStatus === 'ready');

            if (!pagefindAvailable) {
                await useFallback('pagefind_unavailable');
                return;
            }

            try {
                const pagefind = (window as any).pagefind;
                const searchResponse = await pagefind.search(term);
                if (currentRequestId !== this.searchRequestId) return;

                const rawResults = Array.isArray(searchResponse?.results)
                    ? searchResponse.results
                    : [];

                const settledResults = await Promise.all(
                    rawResults.slice(0, 8).map(async (result: any) => {
                        const data = await result.data();
                        return {
                            url: data.url,
                            title: data.meta?.title || 'Documentation',
                            excerpt: data.excerpt || '',
                        };
                    }),
                );

                if (currentRequestId !== this.searchRequestId) return;

                this.results = settledResults.map((item) => ({
                    url: item.url,
                    title: item.title,
                    excerptText: item.excerpt
                        .replace(/<mark[^>]*>/g, '')
                        .replace(/<\/mark>/g, '')
                        .replace(/&amp;/g, '&')
                        .replace(/&lt;/g, '<')
                        .replace(/&gt;/g, '>')
                        .replace(/&quot;/g, '"')
                        .replace(/&#39;/g, "'"),
                }));
                this.loading = false;
            } catch (error) {
                await useFallback('search_execution_error');
            }
        },
        async searchFromButton() {
            this.open = true;
            await this.search();
            this.$refs.searchInput?.focus();
        },
        async usePopular(term) {
            this.query = term;
            await this.search();
        }
    }"
    @click.outside="open = false"
    @keydown.escape="open = false"
    class="relative w-full max-w-[620px] mx-auto"
>
    <div
        class="flex items-center bg-slate-950/90 border border-slate-700/80 rounded-2xl p-1.5 transition-all duration-200 focus-within:border-sky-400 focus-within:ring-1 focus-within:ring-sky-400 shadow-xl"
        :class="focused ? 'ring-1 ring-sky-400 border-sky-400' : ''"
    >
        <input
            x-ref="searchInput"
            type="text"
            x-model="query"
            @focus="focused = true; open = true; ensureFallbackData()"
            @blur="focused = false"
            @click="open = true"
            @input="loading = query.trim().length > 0"
            @input.debounce.250ms="search()"
            @keydown.enter.prevent="searchFromButton()"
            placeholder="Search docs (e.g. routing, webhooks, auth, telemetry)..."
            class="w-full bg-transparent px-4 py-2.5 text-sm text-white placeholder-slate-500 outline-none font-['Poppins']"
        />
        <button
            type="button"
            @click="searchFromButton()"
            class="flex items-center justify-center w-10 h-10 aspect-square shrink-0 bg-gradient-to-r from-sky-500 to-indigo-600 rounded-xl text-white hover:from-sky-400 hover:to-indigo-500 transition-all shadow-md shadow-sky-500/20 active:scale-95 cursor-pointer"
            aria-label="Search"
        >
            <span class="relative inline-flex w-4 h-4 items-center justify-center">
                <svg
                    x-show="!loading"
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <circle cx="11" cy="11" r="8"></circle>
                    <path d="m21 21-4.3-4.3"></path>
                </svg>
                <span
                    x-show="loading"
                    class="inline-block w-4 h-4 rounded-full border-2 border-white/40 border-t-white animate-spin"
                    style="display: none;"
                ></span>
            </span>
        </button>
    </div>

    <!-- Search Dropdown Results -->
    <div
        x-show="open"
        x-transition
        class="absolute left-0 right-0 mt-2 bg-slate-900/95 border border-slate-800 rounded-2xl shadow-2xl backdrop-blur-xl overflow-hidden z-50 text-left"
        style="display:none;"
    >
        <div class="px-4 py-3 border-b border-slate-800 flex items-center justify-between text-xs font-semibold tracking-wider text-slate-400 uppercase">
            <span x-text="query.trim() ? 'Search Results' : 'Suggested Topics'"></span>
            <span class="text-[10px] text-slate-500 lowercase">esc to close</span>
        </div>

        <div class="max-h-[340px] overflow-y-auto">
            <div x-show="loading" class="px-5 py-6 text-sm text-slate-400 flex items-center gap-3">
                <span class="w-4 h-4 rounded-full border-2 border-sky-400 border-t-transparent animate-spin"></span>
                <span>Searching technical documentation...</span>
            </div>

            <template x-if="!loading && !query.trim()">
                <ul class="py-2">
                    <template x-for="term in popular" :key="term">
                        <li>
                            <button
                                type="button"
                                @click="usePopular(term)"
                                class="w-full text-left px-5 py-2.5 text-sm text-slate-300 hover:bg-slate-800 hover:text-white transition-colors cursor-pointer flex items-center justify-between"
                            >
                                <span class="inline-flex items-center gap-2.5">
                                    <span class="inline-block w-1.5 h-1.5 rounded-full bg-sky-400"></span>
                                    <span x-text="term"></span>
                                </span>
                                <span class="text-xs text-slate-500">&rarr;</span>
                            </button>
                        </li>
                    </template>
                </ul>
            </template>

            <template x-if="!loading && query.trim() && results.length > 0">
                <ul class="py-2 divide-y divide-slate-800/60">
                    <template x-for="result in results" :key="result.url">
                        <li>
                            <a
                                :href="result.url"
                                class="block px-5 py-3 hover:bg-slate-800/70 transition-colors"
                            >
                                <p class="text-sm font-semibold text-white group-hover:text-sky-400" x-text="result.title"></p>
                                <p class="text-xs text-slate-400 mt-1 line-clamp-1" x-text="result.excerptText"></p>
                            </a>
                        </li>
                    </template>
                </ul>
            </template>

            <div
                x-show="!loading && query.trim() && results.length === 0"
                class="px-5 py-8 text-center text-sm text-slate-400"
            >
                No technical docs matching "<span class="text-white" x-text="query"></span>" found.
            </div>
        </div>
    </div>
</div>
