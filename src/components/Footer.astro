---
import Logo from "./Logo.astro";
import { SITE_CONFIG } from "../lib/site-config";
import { getCategories } from "../lib/docs";

const currentYear = new Date().getFullYear();
const categories = await getCategories();

const quickLinks = [
  { name: "Link Shortener", href: "/#shortener" },
  { name: "Live Telemetry", href: "/#analytics" },
  { name: "REST API Docs", href: SITE_CONFIG.links.swagger },
  { name: "Prometheus Metrics", href: SITE_CONFIG.links.metrics },
  { name: "Knowledge Base", href: SITE_CONFIG.links.docsHome },
];

const legalLinks = [
  { name: "Terms & Conditions", href: SITE_CONFIG.links.terms },
  { name: "Privacy Policy", href: SITE_CONFIG.links.privacy },
];
---

<footer class="bg-[#070a10] border-t border-slate-800 text-slate-400 pt-16 pb-12 font-['Poppins']">
  <div class="container-wide">
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr] gap-10 lg:gap-12 mb-12"
    >
      <!-- Brand Column -->
      <div class="space-y-4">
        <Logo />
        <p class="text-slate-400 text-sm leading-relaxed max-w-sm">
          Ultra-high-performance URL shortener with conditional routing, webhook notifications, and live Prometheus telemetry. Engineered with Go, PostgreSQL, and Redis.
        </p>
        <div class="flex items-center gap-3 pt-2">
          <a
            href={SITE_CONFIG.links.github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub Repository"
            class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-slate-900 border border-slate-800 text-slate-400 hover:text-white hover:border-sky-500/40 hover:bg-slate-800 transition-all"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
          </a>
          <a
            href={SITE_CONFIG.links.swagger}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Swagger Documentation"
            class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-slate-900 border border-slate-800 text-slate-400 hover:text-white hover:border-sky-500/40 hover:bg-slate-800 transition-all text-xs font-mono font-bold"
          >
            API
          </a>
        </div>
      </div>

      <!-- Documentation Links -->
      <div>
        <h4 class="text-sm font-bold text-white uppercase tracking-wider mb-4">
          Documentation
        </h4>
        <ul class="space-y-2.5">
          {
            categories.map((category) => (
              <li>
                <a
                  href={`/docs/category/${category.toLowerCase().replace(/\s+/g, "-")}`}
                  class="text-sm text-slate-400 hover:text-sky-400 transition-colors"
                >
                  {category}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-sm font-bold text-white uppercase tracking-wider mb-4">
          Navigation
        </h4>
        <ul class="space-y-2.5">
          {
            quickLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-slate-400 hover:text-sky-400 transition-colors"
                >
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- System Telemetry Badge Column -->
      <div class="space-y-3">
        <h4 class="text-sm font-bold text-white uppercase tracking-wider mb-4">
          System Status
        </h4>
        <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-4 space-y-2">
          <div class="flex items-center justify-between text-xs">
            <span class="text-slate-400">Core Engine:</span>
            <span class="text-emerald-400 font-semibold flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              Operational
            </span>
          </div>
          <div class="flex items-center justify-between text-xs">
            <span class="text-slate-400">Target SLA:</span>
            <span class="text-sky-400 font-mono font-semibold">&lt;10ms</span>
          </div>
          <div class="flex items-center justify-between text-xs">
            <span class="text-slate-400">Telemetry:</span>
            <span class="text-indigo-400 font-mono font-semibold">Prometheus</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div
      class="pt-8 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500"
    >
      <p>&copy; {currentYear} UltraFast Redirector. All rights reserved.</p>
      <div class="flex items-center gap-6">
        {
          legalLinks.map((link) => (
            <a href={link.href} class="hover:text-slate-300 transition-colors">
              {link.name}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>
