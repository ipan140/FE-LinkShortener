---
import Logo from "./Logo.astro";
import { SITE_CONFIG } from "../lib/site-config";

const links = SITE_CONFIG.links;

const navItems = [
    { name: "Shortener", href: "/#shortener" },
    { name: "Live Analytics", href: "/#analytics" },
    { name: "Swagger API", href: links.swagger },
    { name: "Metrics", href: links.metrics },
    { name: "Docs", href: links.docsHome },
];

const currentPath = Astro.url.pathname;
---

<div
    x-data="{
        mobileMenuOpen: false,
        scrolled: false,
        init() {
            window.addEventListener('scroll', () => {
                this.scrolled = window.scrollY > 20;
            });
        }
    }"
>
<header
    class="sticky top-0 z-50 w-full border-b border-slate-800 bg-[#090d16]/95 backdrop-blur-md transition-all duration-300"
    :class="scrolled ? 'shadow-xl shadow-black/40 border-slate-800' : 'border-slate-800/80'"
>
    <div class="container-wide flex h-[76px] items-center justify-between">
        <div class="flex items-center gap-10">
            <a
                href="/"
                class="flex items-center gap-2 group shrink-0 transition-transform active:scale-95"
            >
                <Logo />
            </a>

            <nav class="hidden lg:flex items-center gap-7">
                {
                    navItems.map((navLink) => {
                        const isActive =
                            navLink.href === "/"
                                ? currentPath === "/"
                                : currentPath.startsWith(navLink.href);
                        return (
                            <a
                                href={navLink.href}
                                class:list={[
                                    "text-[15px] font-medium transition-colors inline-flex items-center gap-1 whitespace-nowrap",
                                    isActive
                                        ? "text-sky-400 font-semibold"
                                        : "text-slate-300 hover:text-white",
                                ]}
                                target={
                                    navLink.href.startsWith("http")
                                        ? "_blank"
                                        : undefined
                                }
                                rel={
                                    navLink.href.startsWith("http")
                                        ? "noopener noreferrer"
                                        : undefined
                                }
                            >
                                {navLink.name}
                            </a>
                        );
                    })
                }
            </nav>
        </div>

        <div class="flex items-center gap-4">
            <a
                href={links.swagger}
                target="_blank"
                rel="noopener noreferrer"
                class="hidden sm:inline-flex items-center px-4 py-2 bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-semibold rounded-full hover:bg-emerald-500/20 transition-all active:scale-95 whitespace-nowrap"
            >
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping mr-2"></span>
                Backend Online
            </a>

            <button
                type="button"
                @click="mobileMenuOpen = true"
                class="lg:hidden p-2 text-slate-300 hover:text-white hover:bg-slate-800 rounded-lg transition-all active:scale-90 cursor-pointer"
                aria-label="Toggle Menu"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <line x1="4" x2="20" y1="12" y2="12"></line>
                    <line x1="4" x2="20" y1="6" y2="6"></line>
                    <line x1="10" x2="20" y1="18" y2="18"></line>
                </svg>
            </button>
        </div>
    </div>
</header>

<!-- Mobile Navigation Drawer -->
<template x-teleport="body">
    <div
        x-show="mobileMenuOpen"
        class="fixed inset-0 z-[100] lg:hidden"
        style="display: none;"
    >
        <div
            x-show="mobileMenuOpen"
            x-transition:enter="transition ease-out duration-300"
            x-transition:enter-start="opacity-0"
            x-transition:enter-end="opacity-100"
            x-transition:leave="transition ease-in duration-200"
            x-transition:leave-start="opacity-100"
            x-transition:leave-end="opacity-0"
            @click="mobileMenuOpen = false"
            class="absolute inset-0 bg-black/70 backdrop-blur-sm"
        >
        </div>

        <div
            x-show="mobileMenuOpen"
            x-transition:enter="transition ease-out duration-300"
            x-transition:enter-start="translate-x-full"
            x-transition:enter-end="translate-x-0"
            x-transition:leave="transition ease-in duration-200"
            x-transition:leave-start="translate-x-0"
            x-transition:leave-end="translate-x-full"
            class="absolute inset-y-0 right-0 w-full max-w-xs bg-[#090d16] border-l border-slate-800 shadow-2xl p-7 flex flex-col text-slate-100"
        >
            <div class="flex items-center justify-between mb-8 pb-4 border-b border-slate-800">
                <div class="origin-left scale-[0.9]">
                    <Logo />
                </div>
                <button
                    type="button"
                    @click="mobileMenuOpen = false"
                    class="p-2 text-slate-400 hover:text-white bg-slate-800/80 rounded-xl cursor-pointer"
                    aria-label="Close menu"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="M18 6 6 18"></path>
                        <path d="m6 6 12 12"></path>
                    </svg>
                </button>
            </div>

            <nav class="flex flex-col gap-2">
                {
                    navItems.map((item) => (
                        <a
                            href={item.href}
                            class="px-4 py-3 text-sm font-medium rounded-xl transition-all flex items-center justify-between text-slate-300 hover:bg-slate-800/80 hover:text-white"
                            @click="mobileMenuOpen = false"
                        >
                            {item.name}
                        </a>
                    ))
                }
            </nav>

            <div class="mt-auto pt-6 border-t border-slate-800">
                <a
                    href={links.swagger}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="block w-full py-3 bg-gradient-to-r from-sky-500 to-indigo-600 text-white text-center font-semibold rounded-xl active:scale-95 transition-all text-sm shadow-lg shadow-sky-500/20"
                    @click="mobileMenuOpen = false"
                >
                    Open API Docs
                </a>
            </div>
        </div>
    </div>
</template>
</div>
