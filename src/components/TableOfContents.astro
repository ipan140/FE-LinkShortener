---
interface Props {
    headings: {
        depth: number;
        slug: string;
        text: string;
    }[];
}

const { headings } = Astro.props;
const filteredHeadings = headings.filter((h) => h.depth > 1 && h.depth <= 3);
---

{
    filteredHeadings.length > 0 && (
        <nav
            class="sticky top-24 rounded-2xl border border-slate-800 bg-slate-900/80 backdrop-blur-md p-6 shadow-xl"
            aria-label="Table of contents"
            x-data="{
                activeId: '',
                init() {
                    const observer = new IntersectionObserver((entries) => {
                        entries.forEach(entry => {
                            if (entry.isIntersecting) {
                                this.activeId = entry.target.id;
                            }
                        });
                    }, { rootMargin: '0% 0% -80% 0%' });

                    document.querySelectorAll('h2, h3').forEach(h => observer.observe(h));
                }
            }"
        >
            <h5 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-4 flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
                On this page
            </h5>
            <ul class="space-y-1">
                {filteredHeadings.map((h) => (
                    <li>
                        <a
                            href={`#${h.slug}`}
                            class="block border-l-2 pl-3 py-1.5 text-xs sm:text-sm leading-snug transition-colors"
                            :class={`activeId === '${h.slug}' ? 'text-sky-400 border-sky-400 font-semibold bg-sky-500/5' : 'border-transparent text-slate-400 hover:text-white hover:border-slate-600'`}
                        >
                            {h.text}
                        </a>
                    </li>
                ))}
            </ul>
        </nav>
    )
}
