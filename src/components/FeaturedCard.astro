---
interface Props {
    title: string;
    category: string;
    href: string;
    date: string;
    description?: string;
}

const {
    title,
    category,
    href,
    date: _date,
    description = "Learn how to get started with this feature and optimize your workflow.",
} = Astro.props;
---

<div
    class="group relative block h-full overflow-hidden rounded-2xl border border-slate-800 bg-slate-900/80 backdrop-blur-md p-6 shadow-xl transition-all duration-300 hover:border-sky-500/50 hover:-translate-y-1 hover:shadow-sky-500/5"
>
    <div class="relative z-10 flex h-full flex-col">
        <div class="flex items-center justify-between mb-4">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-400 text-[10px] font-bold uppercase tracking-wider">
                Featured
            </span>
            <span class="text-xs font-medium text-slate-400">
                {category}
            </span>
        </div>
        <h3 class="text-lg font-bold text-white leading-snug line-clamp-2 mb-3">
            <a href={href} class="hover:text-sky-400 transition-colors">
                {title}
            </a>
        </h3>
        <p class="text-sm text-slate-400 leading-relaxed mb-6 line-clamp-3">
            {description}
        </p>
        <a
            href={href}
            class="group/read mt-auto inline-flex items-center gap-1.5 text-sm font-semibold text-sky-400 hover:text-sky-300 transition-all hover:translate-x-1"
        >
            Read guide
            <span class="transition-transform group-hover/read:translate-x-1">&rarr;</span>
        </a>
    </div>
</div>
