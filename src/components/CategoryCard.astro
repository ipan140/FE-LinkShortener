---
interface Props {
    title: string;
    description: string;
    icon: string;
    count: number;
    href: string;
    articles: { title: string; href: string }[];
}

const { title, description, icon: _icon, count, href, articles } = Astro.props;
---

<div class="group relative overflow-hidden bg-slate-900/80 backdrop-blur-md rounded-2xl border border-slate-800 p-6 sm:p-7 hover:border-sky-500/50 hover:-translate-y-1 hover:shadow-xl hover:shadow-sky-500/5 transition-all duration-300 flex flex-col before:absolute before:inset-x-0 before:top-0 before:h-1 before:bg-gradient-to-r before:from-sky-500 before:to-indigo-500 before:origin-left before:scale-x-0 hover:before:scale-x-100 before:transition-transform before:duration-300">
    <div class="flex items-start gap-4 mb-5">
        <div class="w-11 h-11 rounded-xl bg-gradient-to-tr from-sky-500/20 to-indigo-500/20 border border-sky-500/30 text-sky-400 flex items-center justify-center flex-shrink-0 transition-transform duration-200 ease-out group-hover:scale-110">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 12H15M9 16H15M17 21H7C5.89543 21 5 20.1046 5 19V5C5 3.89543 5.89543 3 7 3H12.5858C12.851 3 13.1054 3.10536 13.2929 3.29289L18.7071 8.70711C18.8946 8.89464 19 9.149 19 9.41421V19C19 20.1046 18.1046 21 17 21Z"></path>
            </svg>
        </div>
        <div>
            <h3 class="text-lg font-bold text-white leading-snug">
                <a href={href} class="hover:text-sky-400 transition-colors">{title}</a>
            </h3>
            <span class="text-xs font-medium text-slate-400">{count} articles</span>
        </div>
    </div>

    <p class="text-sm text-slate-400 leading-relaxed mb-6 line-clamp-3">{description}</p>

    <div class="space-y-2.5 flex-grow">
        {
            articles.map((article) => (
                <a
                    href={article.href}
                    class="group/article flex items-start gap-2 text-sm text-slate-300 hover:text-sky-400 transition-colors"
                >
                    <span class="text-slate-500 mt-0.5 flex-shrink-0 transition-all group-hover/article:text-sky-400 group-hover/article:translate-x-1">&rarr;</span>
                    <span class="leading-snug line-clamp-2">{article.title}</span>
                </a>
            ))
        }
    </div>

    <a href={href} class="group/view inline-flex items-center gap-1.5 mt-6 pt-2 text-sm font-semibold text-sky-400 hover:text-sky-300 transition-all hover:translate-x-1 border-t border-slate-800/80">
        View category guides
        <span class="transition-transform group-hover/view:translate-x-1">&rarr;</span>
    </a>
</div>
