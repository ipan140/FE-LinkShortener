---
import Layout from "../layouts/Layout.astro";
import Logo from "../components/Logo.astro";
---

<Layout title="404 - Page Not Found">
    <div class="min-h-[70vh] flex items-center justify-center py-20 px-6 bg-[#090d16] text-slate-100">
        <div class="max-w-2xl w-full text-center">
            <!-- Glassmorphism Container -->
            <div
                class="bg-slate-900/80 backdrop-blur-xl border border-slate-800 p-10 md:p-16 rounded-3xl shadow-2xl relative overflow-hidden"
            >
                <!-- Glow Accents -->
                <div class="absolute -top-20 -right-20 w-56 h-56 bg-sky-500/10 rounded-full blur-3xl pointer-events-none"></div>
                <div class="absolute -bottom-20 -left-20 w-56 h-56 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>

                <div class="relative z-10 flex flex-col items-center">
                    <div class="mb-8 scale-110">
                        <Logo />
                    </div>

                    <h1
                        class="text-7xl md:text-8xl font-black bg-gradient-to-r from-sky-400 to-indigo-400 bg-clip-text text-transparent mb-4 tracking-tighter"
                    >
                        404
                    </h1>

                    <h2
                        class="text-2xl md:text-3xl font-extrabold text-white mb-4 tracking-tight"
                    >
                        Page Not Found
                    </h2>

                    <p
                        class="text-slate-400 text-sm sm:text-base mb-8 max-w-md leading-relaxed"
                    >
                        The URL or documentation page you are looking for might have been moved or does not exist.
                    </p>

                    <div class="flex flex-wrap justify-center gap-4">
                        <a
                            href="/"
                            class="px-6 py-3 bg-gradient-to-r from-sky-500 to-indigo-600 text-white text-sm font-semibold rounded-xl hover:from-sky-400 hover:to-indigo-500 transition-all shadow-lg shadow-sky-500/20 active:scale-95 flex items-center gap-2"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="18"
                                height="18"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                <polyline points="9 22 9 12 15 12 15 22"></polyline>
                            </svg>
                            Back to Home
                        </a>
                        <a
                            href="/docs"
                            class="px-6 py-3 bg-slate-800 border border-slate-700 text-slate-200 text-sm font-semibold rounded-xl hover:bg-slate-700 hover:text-white transition-all active:scale-95 flex items-center gap-2"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="18"
                                height="18"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
                                <polyline points="14 2 14 8 20 8"></polyline>
                            </svg>
                            Browse Documentation
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</Layout>
