---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import ShortenerDashboard from "../components/ShortenerDashboard.astro";
import SearchHero from "../components/SearchHero.astro";
import CategoryCard from "../components/CategoryCard.astro";
import FeaturedCard from "../components/FeaturedCard.astro";
import { getDocUrl } from "../lib/docs";

const allDocs = await getCollection("docs");

const categoriesMap = allDocs.reduce(
  (acc, doc) => {
    const category = doc.data.category || "Uncategorized";
    if (!acc[category]) {
      acc[category] = {
        title: category,
        description: `Comprehensive guides and tutorials for ${category}.`,
        icon: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>',
        count: 0,
        href: `/docs/category/${category.toLowerCase().replace(/\s+/g, "-")}`,
        articles: [],
      };
    }
    acc[category].count++;
    if (acc[category].articles.length < 5) {
      acc[category].articles.push({
        title: doc.data.title,
        href: getDocUrl(doc),
      });
    }
    return acc;
  },
  {} as Record<string, any>,
);

interface Category {
  title: string;
  description: string;
  icon: string;
  count: number;
  href: string;
  articles: { title: string; href: string }[];
}

const allCategories = Object.values(categoriesMap) as Category[];
const categoryOrder = [
  "Getting Started",
  "Features & Routing",
  "Webhooks & Telemetry",
  "API Reference",
];
const sortedCategories = [...allCategories].sort((a, b) => {
  const ai = categoryOrder.indexOf(a.title);
  const bi = categoryOrder.indexOf(b.title);
  const an = ai === -1 ? Number.MAX_SAFE_INTEGER : ai;
  const bn = bi === -1 ? Number.MAX_SAFE_INTEGER : bi;
  if (an === bn) return a.title.localeCompare(b.title);
  return an - bn;
});
const firstCategoryHref =
  sortedCategories[0]?.href ||
  `/docs/category/${allCategories[0]?.title?.toLowerCase().replace(/\s+/g, "-")}`;

interface FeaturedArticle {
  title: string;
  category: string;
  date: string;
  href: string;
  description: string;
}

const featuredArticles = allDocs
  .sort(
    (a, b) =>
      (b.data.lastUpdated?.getTime() || 0) -
      (a.data.lastUpdated?.getTime() || 0),
  )
  .slice(0, 3)
  .map((doc) => ({
    title: doc.data.title,
    category: doc.data.category,
    date: doc.data.lastUpdated
      ? new Intl.DateTimeFormat("en-US", {
          month: "short",
          day: "2-digit",
          year: "numeric",
        }).format(doc.data.lastUpdated)
      : "Recently Updated",
    href: getDocUrl(doc),
    description:
      doc.data.description ||
      `Learn how to configure ${doc.data.title} and optimize link delivery speed.`,
  })) as FeaturedArticle[];

const recentlyUpdated = allDocs
  .sort(
    (a, b) =>
      (b.data.lastUpdated?.getTime() || 0) -
      (a.data.lastUpdated?.getTime() || 0),
  )
  .slice(0, 4)
  .map((doc) => ({
    title: doc.data.title,
    category: doc.data.category || "General",
    date: doc.data.lastUpdated
      ? new Intl.DateTimeFormat("en-US", {
          month: "short",
          day: "2-digit",
          year: "numeric",
        }).format(doc.data.lastUpdated)
      : "Recently Updated",
    href: getDocUrl(doc),
    description:
      doc.data.description ||
      `Learn more about ${doc.data.title} in our detailed technical documentation.`,
    timeAgo: doc.data.lastUpdated
      ? getTimeAgo(doc.data.lastUpdated)
      : "recently",
  }));

function getTimeAgo(date: Date): string {
  const now = new Date();
  const diff = now.getTime() - date.getTime();
  const days = Math.floor(diff / (1000 * 60 * 60 * 24));
  if (days < 7) return `${days} days ago`;
  const weeks = Math.floor(days / 7);
  if (weeks < 5) return `${weeks} weeks ago`;
  const months = Math.floor(days / 30);
  return `${months} months ago`;
}

const popularArticles = allDocs.slice(0, 5).map((doc) => ({
  title: doc.data.title,
  href: getDocUrl(doc),
  category: doc.data.category || "Basic",
}));

const categoryDescriptions: Record<string, string> = {
  "Getting Started": "Architecture overview, quickstart guides, and API authentication.",
  "Features & Routing": "Smart Device Routing, Country Geo-Targeting, Fallback URLs, and Password Gates.",
  "Webhooks & Telemetry": "Milestone webhook alerts for Discord, Slack, Telegram, and Prometheus telemetry.",
  "API Reference": "Comprehensive REST endpoints, payload schemas, and OpenAPI Swagger documentation.",
};
---

<Layout title="UltraFast Link Shortener, Smart Routing & Telemetry">
  <ShortenerDashboard />
  <SearchHero
    articleCount={allDocs.length}
    categoryCount={allCategories.length}
    lastUpdatedLabel={recentlyUpdated[0]?.timeAgo || "recently"}
  />

  <section class="py-16 bg-[#090d16] text-slate-100">
    <div class="container-wide">
      <div class="flex flex-col lg:flex-row gap-10 lg:gap-12">
        <!-- Sidebar Navigation -->
        <aside
          class="homepage-sidebar-scroll lg:w-[280px] xl:w-[300px] flex-shrink-0 lg:pr-6 lg:border-r lg:border-slate-800 lg:sticky lg:top-24 lg:max-h-[calc(100vh-7rem)]"
        >
          <div class="space-y-6">
            <!-- Quick Navigation Box -->
            <div
              class="bg-slate-900/80 backdrop-blur-md rounded-2xl border border-slate-800 p-6 shadow-xl"
            >
              <h4
                class="flex items-center gap-2.5 text-base font-bold text-white mb-4"
              >
                <span class="w-2 h-2 rounded-full bg-sky-400"></span>
                Quick Navigation
              </h4>
              <nav class="space-y-1.5">
                {
                  allCategories.map((cat) => (
                    <a
                      href={cat.href}
                      class="group flex items-center justify-between gap-3 py-2 text-sm text-slate-400 hover:text-white hover:translate-x-1 transition-all"
                    >
                      <span class="inline-flex items-center gap-2.5 min-w-0">
                        <span class="w-1.5 h-1.5 rounded-full bg-sky-500/60 group-hover:bg-sky-400 flex-shrink-0 transition-colors" />
                        <span class="font-medium truncate">
                          {cat.title}
                        </span>
                      </span>
                      <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-slate-800 text-slate-400 group-hover:text-white transition-colors flex-shrink-0">
                        {cat.count}
                      </span>
                    </a>
                  ))
                }
              </nav>
            </div>

            <!-- Popular Articles Box -->
            <div
              class="bg-slate-900/80 backdrop-blur-md rounded-2xl border border-slate-800 p-6 shadow-xl"
            >
              <h4
                class="flex items-center gap-2.5 text-base font-bold text-white mb-4"
              >
                <span class="w-2 h-2 rounded-full bg-indigo-400"></span>
                Popular Articles
              </h4>
              <div class="space-y-3.5">
                {
                  popularArticles.map((article) => (
                    <a
                      href={article.href}
                      class="group block text-slate-300 hover:text-sky-400 transition-colors"
                    >
                      <span class="block text-sm font-medium leading-snug group-hover:text-sky-400 transition-colors line-clamp-2">
                        {article.title}
                      </span>
                      <span class="block mt-1 text-xs text-slate-500 group-hover:text-slate-400 transition-colors">
                        {article.category}
                      </span>
                    </a>
                  ))
                }
              </div>
            </div>
          </div>
        </aside>

        <!-- Main Content Area -->
        <main class="flex-grow min-w-0 space-y-14">
          <!-- Featured Topics Section -->
          <div>
            <div
              class="flex items-center justify-between border-b border-slate-800 pb-4 mb-6"
            >
              <h3
                class="text-xl sm:text-2xl font-extrabold text-white tracking-tight"
              >
                Featured Topics
              </h3>
              <a
                href={firstCategoryHref}
                class="text-sm font-semibold text-sky-400 hover:text-sky-300 transition-colors inline-flex items-center gap-1"
              >
                <span>View all</span>
                <span>&rarr;</span>
              </a>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
              {featuredArticles.map((article) => <FeaturedCard {...article} />)}
            </div>
          </div>

          <!-- Browse by Category Section -->
          <div>
            <div class="border-b border-slate-800 pb-4 mb-6">
              <h3
                class="text-xl sm:text-2xl font-extrabold text-white tracking-tight"
              >
                Browse by Category
              </h3>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              {
                allCategories.map((cat) => (
                  <CategoryCard
                    title={cat.title}
                    description={
                      categoryDescriptions[cat.title] || cat.description
                    }
                    icon={cat.icon}
                    count={cat.count}
                    href={cat.href}
                    articles={cat.articles}
                  />
                ))
              }
            </div>
          </div>

          <!-- Recently Updated Section -->
          <div>
            <div class="border-b border-slate-800 pb-4 mb-6">
              <h3
                class="text-xl sm:text-2xl font-extrabold text-white tracking-tight"
              >
                Recently Updated
              </h3>
            </div>
            <div class="space-y-4">
              {
                recentlyUpdated.map((article) => (
                  <div class="rounded-2xl border border-slate-800 bg-slate-900/80 backdrop-blur-md p-6 transition-all hover:border-sky-500/50 hover:bg-slate-900">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
                      <h4 class="text-base sm:text-lg font-bold text-white">
                        <a href={article.href} class="hover:text-sky-400 transition-colors">
                          {article.title}
                        </a>
                      </h4>
                      <span class="inline-flex items-center gap-1.5 text-xs text-slate-400 shrink-0">
                        <span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
                        {article.category} &bull; {article.timeAgo}
                      </span>
                    </div>
                    <p class="text-sm text-slate-400 leading-relaxed line-clamp-2">
                      {article.description}
                    </p>
                  </div>
                ))
              }
            </div>
          </div>
        </main>
      </div>
    </div>
  </section>
</Layout>

<style>
  @media (min-width: 1024px) {
    .homepage-sidebar-scroll {
      scrollbar-width: thin;
      scrollbar-color: #1e293b transparent;
      -ms-overflow-style: auto;
    }

    .homepage-sidebar-scroll::-webkit-scrollbar {
      width: 5px;
      height: 5px;
    }

    .homepage-sidebar-scroll::-webkit-scrollbar-track {
      background: transparent;
    }

    .homepage-sidebar-scroll::-webkit-scrollbar-thumb {
      background-color: #1e293b;
      border-radius: 9999px;
    }
  }
</style>
