---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import Search from "../../../components/Search.astro";
import { getDocUrl } from "../../../lib/docs";

export async function getStaticPaths() {
    const allDocs = await getCollection("docs");
    const categoryOrder = [
        "Getting Started",
        "Features & Routing",
        "Webhooks & Telemetry",
        "API Reference",
    ];
    const categories = [
        ...new Set(allDocs.map((doc) => doc.data.category || "Uncategorized")),
    ].sort((a, b) => {
        const ai = categoryOrder.indexOf(a);
        const bi = categoryOrder.indexOf(b);
        const an = ai === -1 ? Number.MAX_SAFE_INTEGER : ai;
        const bn = bi === -1 ? Number.MAX_SAFE_INTEGER : bi;
        if (an === bn) return a.localeCompare(b);
        return an - bn;
    });
    const categoryCounts = categories.reduce(
        (acc, cat) => {
            acc[cat] = allDocs.filter(
                (doc) => (doc.data.category || "Uncategorized") === cat,
            ).length;
            return acc;
        },
        {} as Record<string, number>,
    );

    return categories.map((category) => {
        const slug = category.toLowerCase().replace(/\s+/g, "-");
        const categoryDocs = allDocs.filter(
            (doc) => (doc.data.category || "Uncategorized") === category,
        );
        return {
            params: { category: slug },
            props: {
                category,
                docs: categoryDocs,
                allDocs,
                allCategories: categories,
                categoryCounts,
            },
        };
    });
}

const { category, docs, allDocs: _allDocs, allCategories, categoryCounts } = Astro.props;

const categoryDescriptions: Record<string, string> = {
    "Getting Started": "Architecture overview, quickstart guides, and API authentication.",
    "Features & Routing": "Smart Device Routing, Country Geo-Targeting, Fallback URLs, and Password Gates.",
    "Webhooks & Telemetry": "Milestone webhook alerts for Discord, Slack, Telegram, and Prometheus telemetry.",
    "API Reference": "Comprehensive REST endpoints, payload schemas, and OpenAPI Swagger documentation.",
};

const docsToDisplay = docs;

// Sort docs by date or title
const sortedDocs = docsToDisplay.sort((a, b) =>
    a.data.title.localeCompare(b.data.title),
);

// Get other categories for the sidebar
const categoriesWithCounts = allCategories.map((cat) => {
    return {
        name: cat,
        slug: cat.toLowerCase().replace(/\s+/g, "-"),
        count: categoryCounts?.[cat] || 0,
    };
});

function getTimeAgo(date?: Date): string {
    if (!date) return "recently";
    const now = new Date();
    const diff = now.getTime() - date.getTime();
    const days = Math.floor(diff / (1000 * 60 * 60 * 24));
    if (days < 7) return `${days} days ago`;
    const weeks = Math.floor(days / 7);
    if (weeks < 5) return `${weeks} weeks ago`;
    const months = Math.floor(days / 30);
    return `${months} months ago`;
}
---

<Layout title={`${category} - UltraFast Docs`}>
    <header class="bg-gradient-to-b from-[#090d16] via-slate-950 to-[#090d16] border-b border-slate-800 py-14 lg:py-16 relative overflow-hidden text-white">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_15%_0%,rgba(56,189,248,0.08),transparent_55%)] pointer-events-none"></div>
        <div class="container-wide relative z-10">
            <nav aria-label="Breadcrumb" class="mb-5">
                <ol class="flex flex-wrap items-center gap-x-3 gap-y-2 text-xs sm:text-sm font-medium text-slate-400">
                    <li class="inline-flex items-center gap-x-2">
                        <a href="/" class="transition-colors hover:text-white">Home</a>
                    </li>
                    <li class="inline-flex items-center gap-x-2">
                        <span class="text-slate-600">/</span>
                        <a href="/docs" class="transition-colors hover:text-white">Documentation</a>
                    </li>
                    <li class="inline-flex items-center gap-x-2">
                        <span class="text-slate-600">/</span>
                        <span class="text-sky-400 font-semibold">{category}</span>
                    </li>
                </ol>
            </nav>

            <h1 class="text-3xl sm:text-5xl font-extrabold text-white mb-4 leading-tight tracking-tight">
                {category}
            </h1>
            <p class="text-slate-400 text-sm sm:text-base max-w-3xl mb-5 leading-relaxed">
                {categoryDescriptions[category] ||
                    `Explore our comprehensive guides and tutorials for ${category}.`}
            </p>
            <div class="text-xs sm:text-sm font-semibold text-sky-400 mb-8 inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-500/10 border border-sky-500/20">
                <span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
                <span>{docsToDisplay.length} technical guides</span>
            </div>

            <div class="max-w-xl">
                <Search />
            </div>
        </div>
    </header>

    <div class="py-16 bg-[#090d16] text-slate-100">
        <div class="container-wide">
            <div class="flex flex-col lg:flex-row gap-10 lg:gap-12">
                <!-- Sidebar: Related Categories -->
                <aside class="lg:w-80 flex-shrink-0">
                    <div
                        class="bg-slate-900/80 backdrop-blur-md rounded-2xl p-6 border border-slate-800 shadow-xl sticky top-24"
                    >
                        <h4
                            class="text-base font-bold text-white mb-4 flex items-center gap-2"
                        >
                            <span class="w-2 h-2 rounded-full bg-sky-400"></span>
                            Categories
                        </h4>
                        <nav class="space-y-1.5">
                            {
                                categoriesWithCounts.map((cat) => (
                                    <a
                                        href={`/docs/category/${cat.slug}`}
                                        class:list={[
                                            "group flex items-center justify-between gap-3 px-3 py-2.5 rounded-xl transition-all text-sm",
                                            cat.name === category
                                                ? "text-sky-400 bg-sky-500/10 font-semibold border border-sky-500/20"
                                                : "text-slate-400 hover:text-white hover:bg-slate-800/60",
                                        ]}
                                    >
                                        <span class="inline-flex items-center gap-2.5 min-w-0">
                                            <span class="w-1.5 h-1.5 rounded-full bg-sky-500/60 group-hover:bg-sky-400 flex-shrink-0"></span>
                                            <span class="truncate font-medium">
                                                {cat.name}
                                            </span>
                                        </span>
                                        <span class="inline-flex items-center justify-center min-w-[24px] h-[24px] px-1.5 rounded-full bg-slate-800 text-slate-400 text-xs font-semibold">
                                            {cat.count}
                                        </span>
                                    </a>
                                ))
                            }
                        </nav>
                    </div>
                </aside>

                <!-- Article List -->
                <main
                    class="flex-grow min-w-0"
                    x-data={`{
                        currentPage: 1,
                        perPage: 10,
                        totalItems: ${sortedDocs.length},
                        get totalPages() {
                            return Math.max(1, Math.ceil(this.totalItems / this.perPage));
                        },
                        get startIndex() {
                            return (this.currentPage - 1) * this.perPage + 1;
                        },
                        get endIndex() {
                            return Math.min(this.currentPage * this.perPage, this.totalItems);
                        },
                        goToPage(page) {
                            this.currentPage = Math.min(Math.max(page, 1), this.totalPages);
                        },
                        isVisible(index) {
                            const start = (this.currentPage - 1) * this.perPage;
                            const end = this.currentPage * this.perPage;
                            return index >= start && index < end;
                        }
                    }`}
                >
                    <div
                        class="flex items-center justify-between mb-6 border-b border-slate-800 pb-4"
                    >
                        <h3 class="text-xl sm:text-2xl font-extrabold text-white tracking-tight">
                            Articles in {category}
                        </h3>
                        <span
                            class="text-xs text-slate-400"
                            x-text="`Showing ${startIndex}-${endIndex} of ${totalItems} articles`"
                        ></span>
                    </div>

                    <div class="space-y-4">
                        {
                            sortedDocs.map((doc, index) => (
                                <article
                                    x-show={`isVisible(${index})`}
                                    class="bg-slate-900/80 backdrop-blur-md rounded-2xl p-6 border border-slate-800 hover:border-sky-500/50 hover:bg-slate-900 transition-all"
                                >
                                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
                                        <h4 class="text-base sm:text-lg font-bold text-white">
                                            <a
                                                href={getDocUrl(doc)}
                                                class="transition-colors hover:text-sky-400"
                                            >
                                                {doc.data.title}
                                            </a>
                                        </h4>
                                        <span class="text-xs text-slate-400 shrink-0">
                                            {getTimeAgo(doc.data.lastUpdated)}
                                        </span>
                                    </div>
                                    <p class="text-slate-400 text-sm leading-relaxed mb-4 line-clamp-2">
                                        {doc.data.description ||
                                            "Detailed guide with code examples and best practices."}
                                    </p>
                                    <a
                                        href={getDocUrl(doc)}
                                        class="group inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-sky-400 hover:text-sky-300 transition-colors"
                                    >
                                        <span>Read article</span>
                                        <span class="transition-transform group-hover:translate-x-1">&rarr;</span>
                                    </a>
                                </article>
                            ))
                        }
                    </div>
                </main>
            </div>
        </div>
    </div>
</Layout>
